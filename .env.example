# ===================================================
# MEDVEIL Environment Configuration Example
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Security
JWT_SECRET=medveil_super_secret_jwt_key_replace_in_production_32bytes_min!
SESSION_SECRET=medveil_session_secret_for_cookies_32bytes_long!
AES_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database
DB_PATH=backend/src/database/medveil.sqlite

# Blockchain / RPC Configuration
# Local Hardhat Node: http://127.0.0.1:8545
# Polygon Amoy: https://rpc-amoy.polygon.technology
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Deployer / Relayer Private Key (Hardhat Account #0 default test key)
# Local Hardhat only. Never use this key on Sepolia or mainnet.
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Sepolia deployment (use a dedicated testnet wallet and an RPC provider)
SEPOLIA_RPC_URL=
SEPOLIA_DEPLOYER_PRIVATE_KEY=
# Optional MetaMask insurer wallet to authorize during deployment
SEPOLIA_INSURER_ADDRESS=

# Hospital BabyJubJub EdDSA Private Seed (32-byte hex for synthetic hospital)
HOSPITAL_EDDSA_SEED=4c696665536176657273486f73706974616c5365656432303236303130313031

# Deployed Contract Addresses (Updated automatically upon running deploy script)
VERIFIER_CONTRACT_ADDRESS=
HOSPITAL_REGISTRY_ADDRESS=
POLICY_REGISTRY_ADDRESS=
CLAIM_SETTLEMENT_ADDRESS=
PATIENT_ACCESS_ADDRESS=
TEST_TOKEN_ADDRESS=

# IPFS Storage (Optional - Local storage adapter active when unset)
IPFS_API_URL=
IPFS_API_KEY=
IPFS_GATEWAY=https://ipfs.io/ipfs/
